# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Local SQLite Databases (Store local message history and replay cache)
*.db
*.sqlite
*.sqlite3

# Cryptographic Private Keys (Strict Security Rule: Never commit private keys)
**/keys/*_private.pem
keys/*_private.pem
*.key
certificates/key.pem

# Environments
.env
.venv
env/
venv/
ENV/

# Temporary test outputs
tests/temp_*
temp_*

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
